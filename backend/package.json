{
  "name": "node-setup",
  "version": "1.0.0",
  "main": "index.js",
  "author": "ibuuusteer <brennogivigier@gmail.com>",
  "license": "MIT",
  "scripts": {
    "build": "npx babel src --extensions \".js,.ts\" --out-dir dist --copy-files --no-copy-ignored && cd ../frontend && npm run build",
    "start": "node dist/server.js",
    "server": "ts-node-dev -r tsconfig-paths/register --respawn --transpileOnly --ignore-watch node_modules --no-notify src/server.ts",
    "dev": "concurrently --kill-others-on-fail \"npm run server\" \"cd ../frontend && npm run start\"",
    "migrate": "prisma migrate dev",
    "deploy": "npm install --frozen-lockfile --legacy-peer-deps && npx prisma generate && npx prisma migrate deploy && npx babel src --extensions \".js,.ts\" --out-dir dist --copy-files --no-copy-ignored && cd ../frontend && npm install --frozen-lockfile --legacy-peer-deps && NODE_OPTIONS=--openssl-legacy-provider npx react-app-rewired build"
  },
  "devDependencies": {
    "@babel/cli": "^7.10.1",
    "@babel/core": "^7.10.2",
    "@babel/node": "^7.10.1",
    "@babel/preset-env": "^7.10.2",
    "@babel/preset-typescript": "^7.10.1",
    "@prisma/cli": "^2.4.1",
    "@types/express": "^4.17.6",
    "@typescript-eslint/eslint-plugin": "^3.8.0",
    "@typescript-eslint/parser": "^3.8.0",
    "babel-plugin-module-resolver": "^4.0.0",
    "concurrently": "^5.2.0",
    "eslint": "^7.6.0",
    "eslint-config-airbnb-base": "^14.2.0",
    "eslint-config-prettier": "^6.11.0",
    "eslint-config-standard": "^14.1.1",
    "eslint-plugin-import": "2.21.2",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^3.1.4",
    "eslint-plugin-promise": "^4.2.1",
    "eslint-plugin-standard": "^4.0.1",
    "prettier": "^2.0.5",
    "prisma": "^6.18.0",
    "ts-node-dev": "^1.0.0-pre.49",
    "tsconfig-paths": "^3.9.0",
    "typescript": "~3.7.2"
  },
  "dependencies": {
    "@prisma/client": "^6.18.0",
    "dotenv": "^8.2.0",
    "express": "^4.17.1"
  }
}
